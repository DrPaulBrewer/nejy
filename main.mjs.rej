@@ -188,6 +192,20 @@
             return target.rpcClient.request(method, params);
         });

+        // Supervisor Loop to update memory/CPU across the entire Node process
+        const monitorInterval = setInterval(() => {
+            try {
+                mon.usage.fsBytes += Atomics.exchange(quotaArray, 1, 0); // pull delta
+                mon.checkResources();
+                Atomics.store(quotaArray, 0, 0); // Not exhausted
+            } catch (err) {
+                Atomics.store(quotaArray, 0, 1); // Signal workers to die
+                clearInterval(monitorInterval);
+                console.error(`❌ Fatal Error: ${err.message}`);
+                processOutput(err.message, null, mon.usage);
+                process.exit(1);
+            }
+        }, 100);
         createWorker("root", scannedProg, policy, scanner.requestList, true);
     });
