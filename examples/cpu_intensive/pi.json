[
  ["EXEC", ["console.log", ["--- Calculating Pi (Fixed Leibniz) ---"]]],
  ["SET",  ["sum", 0]],

  ["F", [
    "ON_QUOTA",
    ["USAGE", "&VARS"],
    [
      ["EXEC", ["math.multiply", ["$VARS.sum", 4], "piVal"]],
      ["EXEC", ["console.log", ["🏁 Final Breath Pi:",    "$piVal"]]],
      ["EXEC", ["console.log", ["🔢 Iterations:", "$VARS.ITEM"]]],
      ["EXEC", ["console.log", ["📊 Final Usage Report:",  "$USAGE"]]]
    ]
  ]],

  ["FOR_EACH", [
    1000000000,
    [
      ["EXEC", ["math.multiply", ["$ITEM", 2], "doubled"]],
      ["EXEC", ["math.add",      ["$doubled", 1], "divisor"]],
      ["EXEC", ["math.divide",   [1, "$divisor"], "term"]],
      ["EXEC", ["math.mod",      ["$ITEM", 2], "parity"]],
      ["IF", [
        "$parity",
        [["EXEC", ["math.subtract", ["$sum", "$term"], "sum"]]],
        [["EXEC", ["math.add",      ["$sum", "$term"], "sum"]]]
      ]]
    ]
  ]]
]
