[
  [
    "EXEC",
    [
      "console.log",
      [
        "--- Pre-Compiled Pi Calculation ---"
      ]
    ]
  ],
  [
    "SET",
    [
      "sum",
      0
    ]
  ],
  
  # 1. Compile the math expression once
  [
    "EXEC",
    [
      "math.compile",
      [
        "$sum = $sum + ((-1)^$ITEM / (2 * $ITEM + 1))"
      ]
    ]
  ],
  [
    "SET",
    [
      "compiledMath",
      "$LAST"
    ]
  ],
  [
    "DEF",
    [
      "ON_QUOTA",
      [
        [
          "EXEC",
          [
            "math.multiply",
            [
              "$sum",
              4
            ]
          ]
        ],
        [
          "EXEC",
          [
            "console.log",
            [
              "🏁 Final Pi:",
              "$LAST"
            ]
          ]
        ],
        [
          "EXEC",
          [
            "console.log",
            [
              "🔢 Iterations:",
              "$ITEM"
            ]
          ]
        ],
        [
          "EXEC",
          [
            "console.log",
            [
              "📊 Usage:",
              "$USAGE"
            ]
          ]
        ]
      ]
    ]
  ],
  [
    "FOR_EACH",
    [
      1000000000,
      [
      # 2. Execute the pre-compiled code using the $VARS scope
      [
          "EXEC",
          [
            "$compiledMath.evaluate",
            [
              "$VARS"
            ]
          ]
        ]
      ]
    ]
  ]
]