[
  ["EXEC", ["console.log", ["--- Extreme High-Speed Pi Calculation ---"]]],
  ["SET", ["sum", 0]],
  
  ["DEF", [
    "ON_QUOTA", 
    [
      ["EXEC", ["math.multiply", ["$sum", 4]]],
      ["EXEC", ["console.log", ["🏁 Final Pi:", "$LAST"]]],
      ["EXEC", ["console.log", ["🔢 Iterations:", "$ITEM"]]],
      ["EXEC", ["console.log", ["📊 Usage:", "$USAGE"]]]]
  ]],

  ["FOR_EACH", [
    1000000000, 
    [
      ["EXEC", ["math.evaluate", ["$sum = $sum + ((-1)^$ITEM / (2 * $ITEM + 1))", "$VARS"]]]
    ]
  ]]
]
